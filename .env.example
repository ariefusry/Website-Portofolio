# Salin ke .env.local dan isi dari Supabase → Project Settings → API.
# Selama kosong, situs tetap jalan memakai konten seed di src/lib/seed.ts,
# dan /admin dialihkan ke beranda.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL produksi — dipakai untuk canonical, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL=https://ariefusry.vercel.app
